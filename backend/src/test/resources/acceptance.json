  {"op":"action","target":"rma","action":"reconcile","role":"reviewer","data":{"externalReference":"BANK-2026-001","actualAmount":90},"error":409},
  {"op":"action","target":"rma","action":"reconcile","role":"reviewer","data":{"externalReference":"BANK-2026-001","actualAmount":100}},
  {"op":"check","target":"rma","expect":{"state":"RECONCILED","data.reconciledBy":"reviewer"}},
  {"op":"count","module":"settlementChecks","count":1},
  {
    "op": "action",
    "target": "rma",
